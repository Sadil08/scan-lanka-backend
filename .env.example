# Scan Lanka backend — local development environment
# Copy to `.env` in this folder (spring-dotenv loads it on `mvn spring-boot:run`):
#   copy .env.example .env
#
# Never commit `.env` with real secrets. `.env` is gitignored.

# ── Database (matches docker-compose.yml) ─────────────────────────────────────
# JVM must use UTC (mvn spring-boot:run sets this). Asia/Calcutta breaks Postgres 16.
DB_URL=jdbc:postgresql://localhost:5432/scanlanka?options=-c%20TimeZone%3DUTC
DB_USER=scanlanka_app
DB_PASSWORD=dev_only_change_me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Initial admin (seeded on first boot when no ADMIN exists) ─────────────────
# Login at http://localhost:3000/login then open http://localhost:3000/admin
INITIAL_ADMIN_EMAIL=admin@scanlanka.com
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin123!

# ── Auth / security (dev only — rotate before production) ─────────────────────
JWT_SECRET=dev-only-change-me-please-rotate-32+bytes-secret
AUTH_COOKIE_SECURE=false
ADMIN_TOTP_REQUIRED=false
CAPTCHA_SECRET=test-captcha-bypass

# ── Frontend / CORS (comma-separated; include every origin you open the site on) ─
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# ── Email (off in dev — OTPs logged to console) ───────────────────────────────
MAIL_ENABLED=false

# ── Optional: dev tunnels (share site with a friend) ─────────────────────────
# Uncomment and set your tunnel URLs, then restart backend + frontend.
# CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-TUNNEL.devtunnels.ms
# FRONTEND_BASE_URL=https://YOUR-FRONTEND-TUNNEL.devtunnels.ms
